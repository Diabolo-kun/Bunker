# ============================================================================
# Unity .gitignore — Proyecto Búnker
# Solo se sube: Assets/, Packages/, ProjectSettings/ y documentos del proyecto
# ============================================================================

# ── Unity auto-generated (NUNCA subir) ──────────────────────────────────────
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/
[Aa]sset[Ss]tore[Tt]ools*/

# ── Cachés de Unity ─────────────────────────────────────────────────────────
# Shader cache, lighting cache, etc.
[Gg]I[Cc]ache/
**/[Ss]patial[Ss]ort/

# ── Archivos autogenerados de Visual Studio / Rider / IDEs ──────────────────
.vs/
.vscode/
.idea/
.consulo/
ExportedObj/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.vsconfig

# Meta files de archivos autogenerados
*.pidb.meta
*.pdb.meta
*.mdb.meta

# ── Crash reports ───────────────────────────────────────────────────────────
sysinfo.txt
crash.dmp

# ── Builds y paquetes ───────────────────────────────────────────────────────
*.apk
*.aab
*.unitypackage
*.app
*.exe
*.dll
!Bunker/Assets/Plugins/**/*.dll

# ── Addressables ────────────────────────────────────────────────────────────
[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# ── TextMeshPro (se importa desde Package Manager, no subir) ────────────────
[Aa]ssets/[Tt]ext[Mm]esh[Pp]ro/

# ── Tutorial de Unity (contenido por defecto que no aporta nada) ────────────
**/TutorialInfo/
**/TutorialInfo.meta

# ── Readme de Unity (archivo por defecto que no necesitamos) ────────────────
**/Readme.asset
**/Readme.asset.meta

# ── Layout del editor (cambia por usuario/sesión, no aporta) ────────────────
*.wlt
*.wlt.meta

# ── Archivos de Plastic SCM / Collaborate ───────────────────────────────────
[Aa]ssets/Plugins/PlasticSCM*

# ── Streaming Assets generados ──────────────────────────────────────────────
[Ss]treamingAssets/aa.meta
[Ss]treamingAssets/aa/

# ── Profiler ────────────────────────────────────────────────────────────────
*.data
!**/Data/Configs/**

# ── OS generated files ──────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ── Varios ──────────────────────────────────────────────────────────────────
*.code-workspace
*.swp
*.swo
*~
